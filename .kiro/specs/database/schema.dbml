// BandUp — database schema (PostgreSQL 16)
// Paste into https://dbdiagram.io/d  (source of truth: design.md §4)
// Status/skill/role/etc. columns are varchar + CHECK constraints in SQL; allowed values are in notes.

Project bandup {
  database_type: 'PostgreSQL'
  Note: '''
  Language rule:
  - Exam content (target language, e.g. English) lives on the main row.
  - Help text (support languages: az, ru, tr, ...) lives in *_translation tables, keyed (owner_id, language_code).
  - Fallback per item: requested -> language.fallback_code -> ... -> en.
  '''
}

// ───────────────────────── Reference ─────────────────────────

Table language {
  code varchar(16) [pk, note: "BCP-47: en, az, ru, pt-BR"]
  name_en text [not null, note: "Azerbaijani"]
  name_native text [not null, note: "Azərbaycanca"]
  direction varchar(3) [not null, default: 'ltr', note: "ltr | rtl"]
  fallback_code varchar(16) [ref: > language.code, note: "pt-BR -> pt -> en"]
  is_target boolean [not null, default: false, note: "can be learned/tested"]
  is_support boolean [not null, default: true, note: "can be a learner's help language"]
  enabled boolean [not null, default: false]
  sort_order int [not null, default: 0]
}

Table question_type {
  code varchar(32) [pk, note: "TFNG, YNNG, MCQ, MCMA, FILL, SUMMARY, SUMMARY_BOX, SHORT, DIAGRAM_LABEL, MATCH_*"]
  family varchar(16) [not null, note: "choiceFixed | gap | mcSingle | mcMulti | match"]
  enabled boolean [not null, default: true]
}

// ───────────────────────── Users ─────────────────────────

Table app_user {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  email text [unique, note: "CHECK email = lower(email)"]
  display_name text
  ui_language varchar(16) [not null, ref: > language.code]
  support_language varchar(16) [not null, ref: > language.code]
  target_language varchar(16) [not null, default: 'en', ref: > language.code]
  status varchar(16) [not null, default: 'ACTIVE', note: "ACTIVE | DISABLED | DELETED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_role {
  user_id bigint [not null, ref: > app_user.id]
  role varchar(16) [not null, note: "LEARNER | AUTHOR | TRANSLATOR | ADMIN"]
  indexes { (user_id, role) [pk] }
}

Table user_credential {
  user_id bigint [pk, ref: - app_user.id, note: "ON DELETE CASCADE"]
  password_hash text [not null, note: "BCrypt hash only"]
  updated_at timestamptz [not null, default: `now()`]
}

Table refresh_token {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > app_user.id, note: "ON DELETE CASCADE"]
  token_hash varchar(64) [not null, unique, note: "SHA-256 hex; CHECK ^[0-9a-f]{64}$"]
  family_id uuid [not null, note: "one login session"]
  issued_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: "CHECK > issued_at"]
  replaced_by bigint [ref: > refresh_token.id, note: "set on rotation"]
  revoked_at timestamptz
  indexes {
    user_id [name: 'refresh_token_user_idx']
    family_id [name: 'refresh_token_family_idx']
  }
}

// ───────────────────────── Curriculum ─────────────────────────

Table course {
  id bigint [pk, increment]
  slug varchar(80) [not null, unique]
  skill varchar(16) [not null, note: "READING | LISTENING | WRITING | SPEAKING | GRAMMAR"]
  target_language varchar(16) [not null, ref: > language.code]
  position int [not null]
  status varchar(16) [not null, default: 'DRAFT', note: "DRAFT | PUBLISHED | ARCHIVED"]
}

Table course_translation {
  course_id bigint [not null, ref: > course.id]
  language_code varchar(16) [not null, ref: > language.code]
  title text [not null]
  description text
  indexes { (course_id, language_code) [pk] }
}

Table stage {
  id bigint [pk, increment]
  course_id bigint [not null, ref: > course.id]
  position int [not null]
  indexes { (course_id, position) [unique] }
}

Table stage_translation {
  stage_id bigint [not null, ref: > stage.id]
  language_code varchar(16) [not null, ref: > language.code]
  title text [not null, note: "Stage 1 / Mərhələ 1"]
  indexes { (stage_id, language_code) [pk] }
}

// ───────────────────────── Exercise ─────────────────────────

Table exercise {
  id bigint [pk, increment]
  slug varchar(120) [not null, unique, note: "public id: /reading/{slug}"]
  skill varchar(16) [not null, note: "READING | LISTENING | ..."]
  target_language varchar(16) [not null, ref: > language.code]
  stage_id bigint [ref: > stage.id, note: "optional grouping; never locks"]
  position int [note: "order within stage; CHECK set together with stage_id"]
  title text [not null, note: "target language"]
  format varchar(8) [not null, default: 'MINI', note: "MINI | FULL (filter)"]
  level varchar(2) [note: "A1 | A2 | B1 | B2 | C1 | C2 (filter); NULL = not set"]
  duration_seconds int [note: "NULL = no timer (grammar). CHECK > 0"]
  low_time_threshold_seconds int [note: "NULL = no warning. CHECK 0 < x <= duration"]
  status varchar(16) [not null, default: 'DRAFT', note: "DRAFT | PUBLISHED | ARCHIVED"]
  revision int [not null, default: 1, note: "bumped on content save; attempts record it"]
  version bigint [not null, default: 0, note: "JPA @Version optimistic lock"]
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > app_user.id]
  updated_by bigint [ref: > app_user.id]
  indexes {
    (stage_id, position) [unique]
  }
  Note: "Partial indexes WHERE status = 'PUBLISHED': exercise_published_idx (stage_id, position), exercise_browse_idx (skill, format, level)"
}

Table topic {
  id bigint [pk, increment]
  slug varchar(60) [not null, unique, note: "nature, science (filter URL)"]
  position int [not null, default: 0]
}

Table topic_translation {
  topic_id bigint [not null, ref: > topic.id]
  language_code varchar(16) [not null, ref: > language.code]
  name text [not null, note: "Nature / Təbiət / Doğa"]
  indexes { (topic_id, language_code) [pk] }
}

Table exercise_topic {
  exercise_id bigint [not null, ref: > exercise.id]
  topic_id bigint [not null, ref: > topic.id]
  indexes {
    (exercise_id, topic_id) [pk]
    topic_id
  }
}

Table media {
  id bigint [pk, increment]
  public_id uuid [not null, unique, default: `gen_random_uuid()`, note: "used in URLs"]
  kind varchar(8) [not null, note: "IMAGE | AUDIO"]
  storage_key text [not null, unique, note: "path in file storage; the file is NOT in the DB"]
  mime_type varchar(64) [not null, note: "image/png, audio/mpeg"]
  byte_size bigint [not null]
  width int [note: "IMAGE"]
  height int [note: "IMAGE"]
  duration_ms int [note: "AUDIO (Listening later)"]
  created_at timestamptz [not null, default: `now()`]
  created_by bigint [ref: > app_user.id]
}

Table media_translation {
  media_id bigint [not null, ref: > media.id]
  language_code varchar(16) [not null, ref: > language.code]
  alt_text text [not null, note: "screen-reader description"]
  indexes { (media_id, language_code) [pk] }
}

Table reading_passage {
  exercise_id bigint [pk, ref: - exercise.id]
  body_html text [not null, note: 'sanitized; <span class="w" data-g="gN"> and <span class="ev" id="eN">']
  word_count int [not null, default: 0]
}

Table passage_gloss {
  id bigint [pk, increment]
  exercise_id bigint [not null, ref: > exercise.id]
  gloss_key varchar(16) [not null, note: "g7 — matches data-g in body_html"]
  surface text [not null, note: "eliminated"]
  lemma text [note: "eliminate"]
  indexes { (exercise_id, gloss_key) [unique] }
}

Table passage_gloss_translation {
  gloss_id bigint [not null, ref: > passage_gloss.id]
  language_code varchar(16) [not null, ref: > language.code]
  meaning text [not null, note: "məhv edilmək"]
  source varchar(8) [not null, default: 'HUMAN', note: "HUMAN | MACHINE"]
  reviewed boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (gloss_id, language_code) [pk] }
}

Table passage_evidence {
  id bigint [pk, increment]
  exercise_id bigint [not null, ref: > exercise.id]
  evidence_key varchar(16) [not null, note: 'e4 — the id="" in body_html']
  indexes {
    (exercise_id, evidence_key) [unique]
    (exercise_id, id) [unique, note: "target of composite FK from question"]
  }
}

// ───────────────────────── Questions ─────────────────────────

Table question_group {
  id bigint [pk, increment]
  exercise_id bigint [not null, ref: > exercise.id]
  position int [not null]
  type_code varchar(32) [not null, ref: > question_type.code]
  instruction_html text [not null, note: "official instruction, target language"]
  choose_count int [note: "mcMulti: Choose TWO -> 2 (= points per question)"]
  max_words int [note: "gap: NO MORE THAN TWO WORDS -> 2; NULL = no limit"]
  numbers_allowed boolean [not null, default: false, note: "... AND/OR A NUMBER"]
  options_reusable boolean [not null, default: false, note: "match: any letter more than once"]
  media_id bigint [ref: > media.id, note: "DIAGRAM_LABEL picture"]
  indexes {
    (exercise_id, position) [unique]
    (exercise_id, id) [unique, note: "target of composite FK from question"]
    (type_code, exercise_id) [name: 'question_group_type_idx', note: "filter by question type"]
  }
}

Table question_group_translation {
  group_id bigint [not null, ref: > question_group.id]
  language_code varchar(16) [not null, ref: > language.code]
  instruction_html text [not null, note: "helper translation"]
  indexes { (group_id, language_code) [pk] }
}

Table question {
  id bigint [pk, increment]
  exercise_id bigint [not null, ref: > exercise.id, note: "denormalized for composite FK"]
  group_id bigint [not null, note: "composite FK below: group from the SAME exercise"]
  position int [not null, note: "within group; number n is DERIVED"]
  stem_text text [note: "statement / question / prompt"]
  stem_pre text [note: "gap: before blank"]
  stem_post text [note: "gap: after blank"]
  evidence_id bigint
  indexes {
    (group_id, position) [unique]
    (exercise_id, evidence_id) [name: 'question_evidence_idx']
  }
  Note: 'CHECK (stem_text IS NOT NULL OR stem_pre IS NOT NULL)'
}

// Group and evidence must belong to the SAME exercise as the question.
Ref: question.(exercise_id, group_id) > question_group.(exercise_id, id) [delete: cascade]
Ref: question.(exercise_id, evidence_id) > passage_evidence.(exercise_id, id)

Table question_option {
  id bigint [pk, increment]
  group_id bigint [ref: > question_group.id, note: "match family: shared bank"]
  question_id bigint [ref: > question.id, note: "MCQ: own options"]
  option_key varchar(8) [not null, note: "A, B, i, ii"]
  label text [not null]
  position int [not null]
  indexes {
    (group_id, option_key) [unique]
    (question_id, option_key) [unique]
  }
  Note: 'CHECK exactly one of group_id / question_id is set'
}

Table question_answer {
  id bigint [pk, increment]
  question_id bigint [not null, ref: > question.id]
  value text [not null, note: "FALSE | riverbanks | B"]
  position int [not null]
  indexes { (question_id, value) [unique] }
  Note: 'gap = accepted alternatives; mcMulti = required set; others = exactly one'
}

Table question_explanation {
  question_id bigint [not null, ref: > question.id]
  language_code varchar(16) [not null, ref: > language.code]
  explanation_html text [not null]
  source varchar(8) [not null, default: 'HUMAN', note: "HUMAN | MACHINE"]
  reviewed boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (question_id, language_code) [pk] }
}

// ───────────────────────── Attempts ─────────────────────────

Table attempt {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id bigint [ref: > app_user.id, note: "NULL = anonymous"]
  exercise_id bigint [not null, ref: > exercise.id, note: "ON DELETE RESTRICT"]
  exercise_revision int [not null]
  support_language varchar(16) [not null, ref: > language.code]
  started_at timestamptz
  submitted_at timestamptz [not null, default: `now()`]
  elapsed_seconds int [not null]
  score int [not null, note: "sum of points_awarded"]
  total int [not null, note: "sum of points_possible; CHECK score <= total"]
  indexes {
    (user_id, submitted_at) [name: 'attempt_user_idx']
    (exercise_id, submitted_at) [name: 'attempt_exercise_idx']
  }
}

Table attempt_answer {
  attempt_id uuid [not null, ref: > attempt.id]
  question_id bigint [not null, ref: > question.id, note: "ON DELETE RESTRICT"]
  question_number int [not null, note: "first n shown (7 for Q7-8)"]
  given_value jsonb [not null, note: '"FALSE" | "riverbanks" | ["A","C"]']
  expected_value jsonb [not null, note: "snapshot at grading time"]
  points_awarded int [not null, note: "1 per correct key for Choose N"]
  points_possible int [not null, note: "CHECK awarded <= possible"]
  is_correct boolean [not null, note: "GENERATED: points_awarded = points_possible"]
  indexes {
    (attempt_id, question_id) [pk]
    question_id [name: 'attempt_answer_question_idx']
  }
}

// ───────────────────────── Groups (colours in dbdiagram) ─────────────────────────

TableGroup reference {
  language
  question_type
}

TableGroup users {
  app_user
  user_role
  user_credential
  refresh_token
}

TableGroup curriculum {
  course
  course_translation
  stage
  stage_translation
}

TableGroup topics {
  topic
  topic_translation
  exercise_topic
}

TableGroup content {
  exercise
  reading_passage
  passage_gloss
  passage_gloss_translation
  passage_evidence
  media
  media_translation
}

TableGroup questions {
  question_group
  question_group_translation
  question
  question_option
  question_answer
  question_explanation
}

TableGroup attempts {
  attempt
  attempt_answer
}
