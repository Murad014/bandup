# Lombok settings for the whole project.
config.stopBubbling = true
# Getters keep this codebase's naming: id(), title() — not getId().
lombok.accessors.fluent = true
# No @lombok.Generated in the bytecode: compiled classes don't depend on Lombok at all,
# so the ArchUnit rules (pure-Java domain, Spring-only application layer) still hold.
lombok.addLombokGeneratedAnnotation = false
