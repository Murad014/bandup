# Copy to deploy/.env on the server and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# Your domain, pointing (DNS A record) at this server's IP. "localhost" works for a local try-out.
BANDUP_DOMAIN=bandup.example.com

# Database password (only the app uses it; the database isn't reachable from outside).
POSTGRES_PASSWORD=change-me

# Signs sign-in tokens. At least 32 characters. Changing it signs everyone out.
BANDUP_JWT_SECRET=change-me-to-at-least-32-random-characters

# The first admin account, created on the first start (when no admin exists).
# The password needs at least 10 characters.
BANDUP_ADMIN_EMAIL=you@example.com
BANDUP_ADMIN_PASSWORD=change-me-long
